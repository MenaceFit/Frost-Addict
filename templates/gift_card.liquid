{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'frost.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section"><div class="page-width" style="max-width:560px;text-align:center;display:grid;gap:16px;justify-items:center">
      <p class="logo-text" style="font-size:2rem">{{ settings.logo_text | default: shop.name | escape }}<span class="logo-text__sub">{{ settings.logo_text_sub | escape }}</span></p>
      <h1 class="h-display" style="font-size:clamp(2rem,6vw,3.5rem)">{{ gift_card.initial_value | money }}</h1>
      {%- if gift_card.expired or gift_card.enabled == false -%}<p class="notice notice--error">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <p>{{ 'gift_card.code' | t }}</p>
      <p class="notice" style="font-size:var(--fs-xl);font-weight:800;letter-spacing:.1em">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}{%- assign balance = gift_card.balance | money -%}<p>{{ 'gift_card.balance' | t: balance: balance }}</p>{%- endif -%}
      <div class="qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a class="btn btn--accent" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}">{{ 'gift_card.apple_wallet' | t }}</a>{%- endif -%}
    </div></main>
  </body>
</html>
