<section class="section section--tight">
  <div class="page-width">
    <h1 class="page-title h-display">{{ 'customer.account' | t }}</h1>
    <p><a href="{{ routes.account_logout_url }}" style="text-decoration:underline">{{ 'customer.logout' | t }}</a></p>
    <div class="cart-page" style="margin-top:24px">
      <div>
        <h2 class="h-italic" style="font-size:var(--fs-xl);margin-bottom:16px">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr><td><a href="{{ order.customer_url }}" style="text-decoration:underline">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p class="muted">{{ 'customer.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <aside class="cart-page__summary">
        <h2 class="h-italic" style="font-size:var(--fs-lg)">{{ 'customer.details' | t }}</h2>
        {{ customer.default_address | format_address }}
        <a href="{{ routes.account_addresses_url }}" class="btn btn--outline btn--sm">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a>
      </aside>
    </div>
  </div>
</section>
