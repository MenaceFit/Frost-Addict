<section class="section section--tight">
  <div class="page-width" style="max-width:520px">
    <div id="Login">
      <h1 class="page-title h-display">{{ 'customer.login' | t }}</h1>
      {%- form 'customer_login', class: 'form' -%}
        {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label>{{ 'customer.email' | t }}<input class="field-input" type="email" name="customer[email]" autocomplete="email" required></label>
        <label>{{ 'customer.password' | t }}<input class="field-input" type="password" name="customer[password]" autocomplete="current-password" required></label>
        <button class="btn btn--accent btn--block" type="submit">{{ 'customer.sign_in' | t }}</button>
        <a href="#Recover" data-toggle-recover style="font-size:var(--fs-sm);text-decoration:underline">{{ 'customer.forgot' | t }}</a>
        <a href="{{ routes.account_register_url }}" class="btn btn--outline btn--block">{{ 'customer.create' | t }}</a>
      {%- endform -%}
    </div>
    <div id="Recover" style="margin-top:48px">
      <h2 class="h-italic" style="font-size:var(--fs-xl);margin-bottom:16px">{{ 'customer.reset_title' | t }}</h2>
      {%- form 'recover_customer_password', class: 'form' -%}
        {%- if form.posted_successfully? -%}<p class="notice notice--success">{{ 'customer.reset_sent' | t }}</p>{%- endif -%}
        <label>{{ 'customer.email' | t }}<input class="field-input" type="email" name="email" autocomplete="email" required></label>
        <button class="btn btn--dark" type="submit">{{ 'customer.send' | t }}</button>
      {%- endform -%}
    </div>
    {%- if shop.checkout.guest_login -%}
      <div style="margin-top:48px">
        {%- form 'guest_login' -%}<button class="btn btn--outline btn--block" type="submit">{{ 'customer.guest' | t }}</button>{%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>
