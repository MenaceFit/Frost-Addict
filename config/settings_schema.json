[
  {
    "name": "theme_info",
    "theme_name": "Frost District Winter",
    "theme_version": "1.0.0",
    "theme_author": "Frost District",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo et identité",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (image)",
        "info": "Laisser vide pour afficher le logo texte."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Largeur du logo",
        "default": 130
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo texte — ligne 1",
        "default": "FROST"
      },
      {
        "type": "text",
        "id": "logo_text_sub",
        "label": "Logo texte — ligne 2",
        "default": "DISTRICT"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32 px, PNG"
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Turquoise signature (CTA, accents)",
        "default": "#31C9CC"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Texte sur turquoise",
        "default": "#101114",
        "info": "Noir recommandé : le blanc sur turquoise n'est pas assez contrasté."
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Noir profond (texte)",
        "default": "#101114"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fond",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_soft",
        "label": "Gris très clair (fonds produits)",
        "default": "#F5F6F7"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Gris moyen (bordures)",
        "default": "#D9DDE1"
      },
      {
        "type": "color",
        "id": "color_ice",
        "label": "Bleu glacier (discret)",
        "default": "#B9D8ED"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Prix soldé",
        "default": "#0B7C7F"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Police des titres",
        "default": "inter_n9"
      },
      {
        "type": "checkbox",
        "id": "heading_italic",
        "label": "Titres courts en italique (style streetwear)",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police du texte",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "label": "Largeur maximale",
        "default": 1440
      },
      {
        "type": "range",
        "id": "radius_card",
        "min": 0,
        "max": 28,
        "step": 2,
        "unit": "px",
        "label": "Arrondi des cartes",
        "default": 18
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "Forme des boutons",
        "default": "pill",
        "options": [
          {
            "value": "pill",
            "label": "Arrondis (pilule)"
          },
          {
            "value": "soft",
            "label": "Coins légers"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "animations",
        "label": "Animations d'apparition au défilement",
        "default": true,
        "info": "Désactivées automatiquement si le visiteur a réduit les animations dans son système."
      },
      {
        "type": "image_picker",
        "id": "collection_banner",
        "label": "Bannière par défaut des collections",
        "info": "Utilisée quand une collection n'a pas d'image."
      }
    ]
  },
  {
    "name": "Cartes produits",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Afficher la marque",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Seconde image au survol",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Afficher les couleurs disponibles",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Ajout rapide au panier",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Afficher la note (si une app d'avis remplit les données)",
        "default": true
      },
      {
        "type": "select",
        "id": "card_sale_badge",
        "label": "Badge de réduction",
        "default": "vertical",
        "options": [
          {
            "value": "vertical",
            "label": "Étiquette verticale « Économisez X % »"
          },
          {
            "value": "pill",
            "label": "Pastille « -X % »"
          },
          {
            "value": "none",
            "label": "Aucun"
          }
        ]
      },
      {
        "type": "text",
        "id": "new_tag",
        "label": "Tag produit pour le badge « Nouveau »",
        "default": "nouveau"
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Format des images",
        "default": "square",
        "options": [
          {
            "value": "square",
            "label": "Carré"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ]
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Cadrage des images",
        "default": "contain",
        "options": [
          {
            "value": "contain",
            "label": "Produit entier (détouré)"
          },
          {
            "value": "cover",
            "label": "Remplir le cadre (photo)"
          }
        ]
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Panier latéral"
          },
          {
            "value": "page",
            "label": "Page panier"
          }
        ]
      },
      {
        "type": "text",
        "id": "cart_reassurance",
        "label": "Message sous le bouton de commande",
        "default": "Paiement 100 % sécurisé"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Livraison offerte dès (€)",
        "default": 65,
        "info": "Doit correspondre à vos tarifs dans Paramètres → Expédition. 0 pour masquer la jauge."
      },
      {
        "type": "text",
        "id": "free_shipping_zone",
        "label": "Zone concernée",
        "default": "en France"
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram (URL)"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok (URL)"
      },
      {
        "type": "text",
        "id": "social_snapchat",
        "label": "Snapchat (URL)"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube (URL)"
      }
    ]
  },
  {
    "name": "Référencement",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image de partage par défaut",
        "info": "Utilisée sur les réseaux sociaux quand la page n'a pas d'image."
      }
    ]
  }
]