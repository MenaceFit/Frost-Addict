{%- comment -%}
  Free-shipping progress. Threshold comes from theme settings and must match the store's
  real shipping rates (Settings → Shipping). Shown only in the shop's own currency.
{%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 and cart.currency.iso_code == shop.currency -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship-bar{% if remaining <= 0 %} is-done{% endif %}" data-ship-bar>
    <p class="ship-bar__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money, zone: settings.free_shipping_zone }}
      {%- else -%}
        {% render 'icon', name: 'truck' %} {{ 'cart.free_shipping_done' | t: zone: settings.free_shipping_zone }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track" role="progressbar" aria-label="{{ 'cart.free_shipping_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><span style="--p: {{ pct | divided_by: 100.0 }}"></span></div>
  </div>
{%- endif -%}
