{%- comment -%}
  Section heading: optional marker label, big title, optional subtitle.
  Params: eyebrow, title, subtitle, align ('center' | 'left'), tag (default h2)
{%- endcomment -%}
{%- assign tag = tag | default: 'h2' -%}
{%- if title != blank or eyebrow != blank or subtitle != blank -%}
  <div class="section-head{% if align == 'left' %} section-head--left{% endif %}">
    {%- if eyebrow != blank -%}<p class="section-head__eyebrow" data-reveal>{{ eyebrow | escape }}</p>{%- endif -%}
    {%- if title != blank -%}<{{ tag }} class="section-head__title h-display" data-reveal style="--delay:.06s">{{ title | escape }}</{{ tag }}>{%- endif -%}
    {%- if subtitle != blank -%}<p class="section-head__sub" data-reveal style="--delay:.12s">{{ subtitle | escape }}</p>{%- endif -%}
  </div>
{%- endif -%}
