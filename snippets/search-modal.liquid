<div class="search-modal" id="SearchModal" role="dialog" aria-modal="true" aria-label="{{ 'search.title' | t }}" data-search-modal>
  <div class="drawer__overlay" data-search-close></div>
  <div class="search-modal__panel">
    <div class="page-width">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        {% render 'icon', name: 'search' %}
        <label class="visually-hidden" for="SearchModalInput">{{ 'search.placeholder' | t }}</label>
        <input id="SearchModalInput" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" data-predictive-input>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="button" class="icon-btn" data-search-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </form>
      <div class="predictive" data-predictive-results aria-live="polite"></div>
    </div>
  </div>
</div>
