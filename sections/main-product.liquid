{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign low_stock = section.settings.low_stock
-%}
<section class="section section--tight" data-product data-section="{{ section.id }}" data-url="{{ product.url }}">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}" style="margin-bottom:20px">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
      {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title | escape }}</a><span aria-hidden="true">/</span>{%- endif -%}
      <span>{{ product.title | escape }}</span>
    </nav>

    <div class="pdp">
      <div class="gallery" data-gallery>
        <div class="gallery__main" data-gallery-track>
          {%- for media in product.media -%}
            <div class="gallery__item" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if forloop.first
                      assign media_loading = 'eager'
                    else
                      assign media_loading = 'lazy'
                    endif
                    assign media_alt = media.alt | default: product.title
                  -%}
                  <a href="{{ media | image_url: width: 2400 }}" target="_blank" rel="noopener" aria-label="{{ 'products.zoom' | t }}">
                    {{ media | image_url: width: 1600 | image_tag: loading: media_loading, widths: '500, 800, 1100, 1600', sizes: '(min-width: 990px) 50vw, 88vw', alt: media_alt }}
                  </a>
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, muted: true, loop: true, playsinline: true, image_size: '1100x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="gallery__item">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="gallery__dots" aria-hidden="true">
            {%- for media in product.media -%}<span{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }} style="display:grid;gap:8px">
                {%- if product.vendor != blank -%}
                  <p class="pdp__vendor" style="margin:0">{{ product.vendor | link_to_vendor }}</p>
                {%- endif -%}
                <h1 class="pdp__title h-italic">{{ product.title | escape }}</h1>
                {% render 'rating', product: product %}
              </div>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }} data-price-wrap>
                {% render 'price', variant: current_variant, size: 'lg' %}
                <p class="pdp__tax">
                  {%- if cart.taxes_included -%}{{ 'products.tax_included' | t }}{%- else -%}{{ 'products.tax_excluded' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} · <a href="{{ shop.shipping_policy.url }}" style="text-decoration:underline">{{ 'products.shipping_link' | t }}</a>{%- endif -%}
                </p>
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div {{ block.shopify_attributes }} style="display:grid;gap:18px" data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign oname = option.name | downcase
                      assign is_color = false
                      if oname == 'couleur' or oname == 'color' or oname == 'colour' or oname == 'coloris'
                        assign is_color = true
                      endif
                      assign option_index = forloop.index0
                    -%}
                    <fieldset class="option" data-option-index="{{ option_index }}">
                      <legend>{{ option.name | escape }} : <span data-option-selected>{{ option.selected_value | escape }}</span></legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0
                            assign swatch_style = ''
                            if is_color and value.swatch.color
                              assign swatch_style = '--swatch: ' | append: value.swatch.color
                            elsif is_color and value.swatch.image
                              assign swatch_url = value.swatch.image | image_url: width: 92
                              assign swatch_style = '--swatch: url(' | append: swatch_url | append: ')'
                            endif
                          -%}
                          <div class="option__value{% if swatch_style != '' %} option__value--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}">
                            <input type="radio" id="{{ input_id }}" name="option-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                            <label for="{{ input_id }}"{% if swatch_style != '' %} style="{{ swatch_style }}" title="{{ value | escape }}"{% endif %}>
                              {%- if swatch_style != '' -%}<span class="visually-hidden">{{ value | escape }}</span>{%- else -%}{{ value | escape }}{%- endif -%}
                            </label>
                          </div>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  {%- if block.settings.size_guide_page != blank -%}
                    <a href="{{ block.settings.size_guide_page.url }}" style="font-size:var(--fs-sm);text-decoration:underline">{{ 'products.size_guide' | t }}</a>
                  {%- endif -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }} style="display:grid;gap:14px">
                {%- form 'product', product, id: form_id, data-product-form: '', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="pdp__buy">
                    <div class="qty qty--lg">
                      <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease_simple' | t }}">{% render 'icon', name: 'minus' %}</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
                      <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase_simple' | t }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                    <button type="submit" name="add" class="btn btn--accent" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                      <span data-add-label>{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="pdp__checkout" style="margin-top:10px">{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="form-message form-message--error" data-form-error role="alert" hidden></p>
                {%- endform -%}
                {%- if block.settings.show_stock -%}
                  <p class="pdp__stock{% if current_variant.available == false %} pdp__stock--out{% elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= low_stock and current_variant.inventory_quantity > 0 %} pdp__stock--low{% endif %}" data-stock style="margin:0">
                    {%- if current_variant.available == false -%}
                      {{ 'products.out_of_stock' | t }}
                    {%- elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= low_stock and current_variant.inventory_quantity > 0 -%}
                      {{ 'products.low_stock' | t: count: current_variant.inventory_quantity }}
                    {%- else -%}
                      {{ 'products.in_stock' | t }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'perks' -%}
              <ul class="pdp__perks" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- assign key = 'perk_' | append: i -%}
                  {%- assign icon_key = 'icon_' | append: i -%}
                  {%- if block.settings[key] != blank -%}
                    <li>{% render 'icon', name: block.settings[icon_key] %} <span>{{ block.settings[key] | escape }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="accordion" {{ block.shopify_attributes }}>
                  <details{% if block.settings.open %} open{% endif %}>
                    <summary>{{ 'products.description' | t }} {% render 'icon', name: 'plus' %}</summary>
                    <div class="accordion__content rte">{{ product.description }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'collapsible' -%}
              {%- if block.settings.content != blank or block.settings.page != blank -%}
                <div class="accordion" style="border-top:0;margin-top:-18px" {{ block.shopify_attributes }}>
                  <details>
                    <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'plus' %}</summary>
                    <div class="accordion__content rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="rte" style="font-size:var(--fs-sm)" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    <div class="sticky-atc__info">
      <p class="sticky-atc__title" style="margin:0">{{ product.title | escape }}</p>
      <div data-sticky-price>{% render 'price', variant: current_variant %}</div>
    </div>
    <button type="button" class="btn btn--accent btn--sm" data-sticky-add tabindex="-1"{% unless current_variant.available %} disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
  </div>

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | money | json }},
            "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "media": {{ v.featured_media.id | default: 'null' }},
            "tracked": {% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %},
            "qty": {{ v.inventory_quantity | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "lowStock": {{ low_stock }},
      "strings": {
        "inStock": {{ 'products.in_stock' | t | json }},
        "outOfStock": {{ 'products.out_of_stock' | t | json }},
        "lowStock": {{ 'products.low_stock_template' | t | json }},
        "regular": {{ 'products.regular_price' | t | json }},
        "sale": {{ 'products.sale_price' | t | json }}
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "range", "id": "low_stock", "min": 1, "max": 10, "step": 1, "label": "Seuil « plus que X en stock »", "default": 3, "info": "Affiché seulement si le stock est suivi par Shopify." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Marque et titre", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1 },
    {
      "type": "variant_picker", "name": "Sélecteur de variantes", "limit": 1,
      "settings": [ { "type": "page", "id": "size_guide_page", "label": "Page « guide des tailles »" } ]
    },
    {
      "type": "buy_buttons", "name": "Boutons d'achat", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Boutons de paiement express", "default": true },
        { "type": "checkbox", "id": "show_stock", "label": "Afficher la disponibilité", "default": true }
      ]
    },
    {
      "type": "perks", "name": "Engagements", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Uniquement des engagements réels." },
        { "type": "select", "id": "icon_1", "label": "Icône 1", "default": "lock", "options": [ { "value": "lock", "label": "Cadenas" }, { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "badge-check", "label": "Certifié" }, { "value": "chat", "label": "Message" } ] },
        { "type": "text", "id": "perk_1", "label": "Engagement 1", "default": "Paiement sécurisé" },
        { "type": "select", "id": "icon_2", "label": "Icône 2", "default": "return", "options": [ { "value": "lock", "label": "Cadenas" }, { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "badge-check", "label": "Certifié" }, { "value": "chat", "label": "Message" } ] },
        { "type": "text", "id": "perk_2", "label": "Engagement 2", "default": "Droit de rétractation de 14 jours" },
        { "type": "select", "id": "icon_3", "label": "Icône 3", "default": "chat", "options": [ { "value": "lock", "label": "Cadenas" }, { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "badge-check", "label": "Certifié" }, { "value": "chat", "label": "Message" } ] },
        { "type": "text", "id": "perk_3", "label": "Engagement 3", "default": "Une question ? Écris-nous" }
      ]
    },
    {
      "type": "description", "name": "Description", "limit": 1,
      "settings": [ { "type": "checkbox", "id": "open", "label": "Ouverte par défaut", "default": true } ]
    },
    {
      "type": "collapsible", "name": "Onglet repliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison et retours" },
        { "type": "richtext", "id": "content", "label": "Contenu" },
        { "type": "page", "id": "page", "label": "Ou contenu d'une page" }
      ]
    },
    { "type": "text", "name": "Texte", "settings": [ { "type": "richtext", "id": "text", "label": "Texte" } ] }
  ]
}
{% endschema %}
