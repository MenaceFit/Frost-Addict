{%- comment -%}
  Customer reviews. Two honest sources only:
  1. An app block from a review app (Judge.me, Loox, Shopify Product Reviews…)
  2. "Avis" blocks the merchant fills with real, verifiable customer reviews.
  With no data, the section is hidden on the live store (empty state shown in the editor only).
{%- endcomment -%}
{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign has_content = false
  if review_blocks.size > 0 or app_blocks.size > 0
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
<section class="section section--soft" id="{{ section.settings.anchor | default: section.id }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, subtitle: section.settings.subheading %}
    {%- for block in app_blocks -%}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endfor -%}
    {%- if review_blocks.size > 0 -%}
      <div class="reviews__grid">
        {%- for block in review_blocks -%}
          {%- assign pct = block.settings.rating | times: 20 -%}
          <figure class="review" data-reveal style="--delay: {{ forloop.index0 | modulo: 3 | times: 0.08 }}s; margin:0" {{ block.shopify_attributes }}>
            <div class="rating"><span class="rating__stars" style="--pct: {{ pct }}%" aria-hidden="true"></span><span class="visually-hidden">{{ 'products.rating' | t: rating: block.settings.rating, max: 5 }}</span></div>
            <blockquote class="review__text" style="margin:0">{{ block.settings.text | escape }}</blockquote>
            <figcaption class="review__meta">
              <span>
                <span class="review__author">{{ block.settings.author | escape }}</span>
                {%- if block.settings.product != blank -%}<br><a class="review__product" href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>{%- endif -%}
              </span>
              {%- if block.settings.verified -%}<span class="review__verified">{% render 'icon', name: 'badge-check' %} {{ 'reviews.verified' | t }}</span>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- unless has_content -%}
      <div class="reviews__empty">
        <p><strong>{{ 'reviews.empty_title' | t }}</strong></p>
        <p class="muted">{{ 'reviews.empty_text' | t }}</p>
      </div>
    {%- endunless -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Avis clients",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (pour liens #)" },
    { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "Avis" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils portent Frost" },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "paragraph", "content": "Ajoutez uniquement de vrais avis clients, ou le bloc d'une application d'avis. La section reste masquée tant qu'elle est vide." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review", "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Avis (texte exact du client)" },
        { "type": "text", "id": "author", "label": "Prénom et initiale" },
        { "type": "product", "id": "product", "label": "Produit concerné" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Avis clients" } ]
}
{% endschema %}
