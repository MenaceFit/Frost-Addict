<section class="section section--tight">
  <div class="page-width">
    <h1 class="page-title h-display">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="cat-grid" style="--cols: 3; --ratio: 4 / 3">
        {%- for article in blog.articles -%}
          <a class="cat-card" href="{{ article.url }}" data-reveal>
            <div class="cat-card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <div class="cat-card__body" style="justify-items:start;text-align:left">
              <p class="cat-card__count" style="margin:0">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="cat-card__title h-italic">{{ article.title | escape }}</h2>
              <p class="muted" style="font-size:var(--fs-sm)">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog" }
{% endschema %}
