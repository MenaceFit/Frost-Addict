<div class="drawer" id="CartDrawer" data-cart-drawer data-count="{{ cart.item_count }}" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__head">
      <h2 class="drawer__title h-italic" id="CartDrawerTitle">{{ 'cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h2>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    {%- if cart.item_count > 0 -%}
      <div class="drawer__body">
        <ul data-cart-lines>
          {%- for item in cart.items -%}{% render 'cart-line', item: item, index: forloop.index %}{%- endfor -%}
        </ul>
      </div>
      <div class="drawer__foot">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-subtotal" style="font-size:var(--fs-sm)"><span>{{ discount.title | escape }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="cart-subtotal"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="cart-note-small">{{ 'cart.taxes_shipping' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--accent btn--block">{% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="btn btn--outline btn--block">{{ 'cart.view_cart' | t }}</a>
        {%- if settings.cart_reassurance != blank -%}<p class="cart-note-small" style="text-align:center">{{ settings.cart_reassurance | escape }}</p>{%- endif -%}
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="cart-empty">
          {% render 'icon', name: 'cart' %}
          <p class="h-italic" style="font-size:var(--fs-lg)">{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "Panier latéral", "class": "shopify-section--cart-drawer" }
{% endschema %}
