{%- comment -%}
  Promo card: dark rounded banner with an accent eyebrow, a condensed title, a short line with
  an arrow and a product cutout on the right. The whole card is one link.
  Only advertise what is really set up in the store (shipping rates, discounts…).
{%- endcomment -%}
<section class="section section--tight promo-card-wrap" {{ section.shopify_attributes }}>
  <div class="page-width">
    <a class="promo-card promo-card--{{ section.settings.style }}" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-reveal>
      <span class="promo-card__flakes" aria-hidden="true"></span>
      <span class="promo-card__text">
        {%- if section.settings.eyebrow != blank -%}<span class="promo-card__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <span class="promo-card__title">{{ section.settings.heading | escape }}</span>
        {%- if section.settings.text != blank -%}<span class="promo-card__line">{{ section.settings.text | escape }} {% render 'icon', name: 'arrow-right', stroke: 2.2 %}</span>{%- endif -%}
      </span>
      {%- if section.settings.image -%}
        <span class="promo-card__media" aria-hidden="true">
          {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 750px) 240px, 34vw', alt: '' }}
        </span>
      {%- endif -%}
    </a>
  </div>
</section>
{% schema %}
{
  "name": "Bannière promo (carte)",
  "settings": [
    { "type": "paragraph", "content": "N'annonce que ce qui existe vraiment dans la boutique (tarif de livraison, code ou remise automatique)." },
    { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "Livraison offerte" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Dès 65 € en France" },
    { "type": "text", "id": "text", "label": "Ligne avec flèche", "default": "Compose ton outfit d'hiver" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "image_picker", "id": "image", "label": "Image à droite (photo détourée)" },
    { "type": "select", "id": "style", "label": "Couleur", "default": "night", "options": [ { "value": "night", "label": "Nuit glacée" }, { "value": "ice", "label": "Turquoise" } ] }
  ],
  "presets": [ { "name": "Bannière promo (carte)" } ]
}
{% endschema %}
