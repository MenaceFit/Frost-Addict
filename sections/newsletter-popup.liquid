{%- unless request.page_type == 'cart' or request.page_type == 'password' -%}
{%- if section.settings.enabled -%}
<div class="popup" id="NewsletterPopup" data-popup data-delay="{{ section.settings.delay | times: 1000 }}" data-days="{{ section.settings.days }}" data-exit="{{ section.settings.exit_intent }}"
  role="dialog" aria-modal="true" aria-labelledby="PopupTitle" hidden {{ section.shopify_attributes }}>
  <div class="popup__overlay" data-popup-close></div>
  <div class="popup__panel">
    <button type="button" class="icon-btn popup__close" data-popup-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    {%- if section.settings.image -%}
      <div class="popup__media">{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 750px) 380px, 100vw', alt: '' }}</div>
    {%- endif -%}
    <div class="popup__content">
      <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="h-display popup__title" id="PopupTitle">{{ section.settings.heading | escape }}</h2>
      <p class="muted">{{ section.settings.text | escape }}</p>
      {%- form 'customer', class: 'popup__form', data-popup-form: '' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">
        {%- if form.posted_successfully? -%}
          <div class="notice notice--success" role="status" data-popup-success>
            <strong>{{ 'newsletter.success' | t }}</strong>
            {%- if section.settings.code != blank -%}
              <p style="margin-top:8px">{{ 'popup.code_intro' | t }}</p>
              <button type="button" class="popup__code" data-copy="{{ section.settings.code | escape }}">{{ section.settings.code | escape }} <small>{{ 'popup.copy' | t }}</small></button>
            {%- endif -%}
          </div>
        {%- else -%}
          <label class="visually-hidden" for="PopupEmail">{{ 'newsletter.email' | t }}</label>
          <input class="field-input" id="PopupEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
          <button class="btn btn--accent btn--block" type="submit">{{ section.settings.button_label | escape }}</button>
          {%- if form.errors -%}<p class="form-message form-message--error" style="color:#b42318">{{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <button type="button" class="popup__later" data-popup-close>{{ 'popup.later' | t }}</button>
    </div>
  </div>
</div>
{%- endif -%}
{%- endunless -%}
{% schema %}
{
  "name": "Popup newsletter",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activer", "default": true },
    { "type": "range", "id": "delay", "min": 3, "max": 60, "step": 1, "unit": "s", "label": "Délai d'apparition", "default": 15 },
    { "type": "checkbox", "id": "exit_intent", "label": "Afficher aussi quand la souris quitte la page (ordinateur)", "default": true },
    { "type": "range", "id": "days", "min": 1, "max": 60, "step": 1, "unit": "j", "label": "Ne plus afficher pendant", "default": 14 },
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "❄ Frost Club" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les drops avant tout le monde" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Inscris-toi : nouveautés, restocks et offres réservées aux membres." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Je rejoins le club" },
    { "type": "text", "id": "code", "label": "Code promo affiché après inscription (optionnel)", "info": "Créez d'abord le code dans Réductions. Laissez vide si aucune offre." }
  ]
}
{% endschema %}
