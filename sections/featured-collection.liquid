{%- liquid
  assign collection = section.settings.collection
  assign show = true
  if collection == blank or collection.products_count == 0
    assign show = false
  endif
-%}
{%- if show -%}
<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}" id="{{ section.settings.anchor | default: section.id }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, subtitle: section.settings.subheading, align: section.settings.heading_align, link_url: collection.url, link_label: section.settings.view_all_label %}
    {% render 'product-list',
      collection: collection,
      limit: section.settings.limit,
      layout: section.settings.layout,
      columns: section.settings.columns,
      label: section.settings.heading
    %}
    {%- if section.settings.view_all_label != blank and collection != blank -%}
      <div class="section-foot{% if section.settings.heading_align == 'left' %} section-foot--mobile{% endif %}"><a href="{{ collection.url }}" class="btn btn--outline">{{ section.settings.view_all_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Collection en avant",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (pour liens #)" },
    { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "Nouveautés" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos nouveautés" },
    { "type": "select", "id": "heading_align", "label": "Alignement du titre", "default": "left", "options": [ { "value": "left", "label": "À gauche (compact, lien « voir tout » à droite)" }, { "value": "center", "label": "Centré (grand titre)" } ] },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Les dernières pièces à découvrir." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 16, "step": 1, "label": "Nombre de produits", "default": 8 },
    { "type": "select", "id": "layout", "label": "Présentation", "default": "carousel", "options": [ { "value": "carousel", "label": "Carrousel" }, { "value": "grid", "label": "Grille" } ] },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Produits par ligne (ordinateur)", "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "Bouton « voir tout »", "default": "Voir tout" },
    { "type": "select", "id": "background", "label": "Fond", "default": "white", "options": [ { "value": "white", "label": "Blanc" }, { "value": "soft", "label": "Gris clair" } ] },
    { "type": "header", "content": "Collection vide" }
  ],
  "presets": [ { "name": "Collection en avant" } ]
}
{% endschema %}
