{%- liquid
  assign all_tabs = section.blocks | where: 'type', 'tab'
  assign visible_ids = ''
  for block in all_tabs
    if request.design_mode or block.settings.collection.products_count > 0
      assign visible_ids = visible_ids | append: block.id | append: ','
    endif
  endfor
  assign visible_count = visible_ids | split: ',' | size
-%}
{%- if visible_count > 0 -%}
<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}" id="{{ section.settings.anchor | default: section.id }}" {{ section.shopify_attributes }} data-tabs>
  <div class="page-width">
    {% render 'section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, subtitle: section.settings.subheading, align: section.settings.heading_align %}
    {%- if visible_count > 1 -%}
      <div class="tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- assign first_done = false -%}
        {%- for block in all_tabs -%}
          {%- assign key = block.id | append: ',' -%}
          {%- unless visible_ids contains key -%}{%- continue -%}{%- endunless -%}
          {%- assign label = block.settings.label | default: block.settings.collection.title | default: 'Onglet' -%}
          <button type="button" class="tabs__tab" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}"
            aria-selected="{% if first_done %}false{% else %}true{% endif %}" tabindex="{% if first_done %}-1{% else %}0{% endif %}" {{ block.shopify_attributes }}>
            {% render 'icon', name: 'arrow-right' %}{{ label | escape }}
          </button>
          {%- assign first_done = true -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- assign first_done = false -%}
    {%- for block in all_tabs -%}
      {%- assign key = block.id | append: ',' -%}
      {%- unless visible_ids contains key -%}{%- continue -%}{%- endunless -%}
      <div class="tabs__panel" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}"{% if first_done %} hidden{% endif %}>
      {%- assign first_done = true -%}
        {% render 'product-list',
          collection: block.settings.collection,
          limit: section.settings.limit,
          layout: 'grid',
          columns: section.settings.columns,
          demo_count: section.settings.columns,
          demo_vendor: block.settings.label,
          demo_titles: '',
          label: block.settings.label
        %}
        {%- if block.settings.collection != blank and section.settings.view_all_label != blank -%}
          <div class="section-foot"><a href="{{ block.settings.collection.url }}" class="btn btn--outline">{{ section.settings.view_all_label | escape }}</a></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Collections à onglets",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (pour liens #)" },
    { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "Top" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos best-sellers" },
    { "type": "select", "id": "heading_align", "label": "Alignement du titre", "default": "left", "options": [ { "value": "left", "label": "À gauche (compact, lien « voir tout » à droite)" }, { "value": "center", "label": "Centré (grand titre)" } ] },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Produits par onglet", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Produits par ligne (ordinateur)", "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "Bouton « voir tout »", "default": "Voir tout" },
    { "type": "select", "id": "background", "label": "Fond", "default": "white", "options": [ { "value": "white", "label": "Blanc" }, { "value": "soft", "label": "Gris clair" } ] }
  ],
  "blocks": [
    {
      "type": "tab", "name": "Onglet",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Libellé (sinon : nom de la collection)" }
      ]
    }
  ],
  "presets": [ { "name": "Collections à onglets", "blocks": [ { "type": "tab" }, { "type": "tab" } ] } ]
}
{% endschema %}
