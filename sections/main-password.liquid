<section class="banner banner--center" style="--overlay:.45;min-height:100vh">
  <div class="banner__media">
    {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1500, 2400', sizes: '100vw', alt: '' }}{%- endif -%}
  </div>
  <div class="page-width banner__inner">
    <div class="banner__content">
      <p class="logo-text" style="font-size:2.5rem;color:#fff">{{ settings.logo_text | default: shop.name | escape }}<span class="logo-text__sub">{{ settings.logo_text_sub | escape }}</span></p>
      <h1 class="banner__title h-display">{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}<p class="hero__text">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        <label class="visually-hidden" for="PwEmail">{{ 'newsletter.email' | t }}</label>
        <input id="PwEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}">
        <button class="btn btn--accent" type="submit">{{ 'newsletter.notify' | t }}</button>
        {%- if form.posted_successfully? -%}<p class="form-message form-message--success" style="flex-basis:100%">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- endform -%}
      <details style="margin-top:24px">
        <summary style="cursor:pointer;text-decoration:underline">{{ 'password.owner' | t }}</summary>
        {%- form 'storefront_password', class: 'newsletter__form' -%}
          <label class="visually-hidden" for="PwInput">{{ 'password.label' | t }}</label>
          <input id="PwInput" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button class="btn btn--light" type="submit">{{ 'password.enter' | t }}</button>
          {%- if form.errors -%}<p class="form-message form-message--error" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
      </details>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo de fond" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Winter drop bientôt" }
  ]
}
{% endschema %}
